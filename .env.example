# ---- App ----
PORT=3000

# ---- MySQL (used by docker-compose) ----
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=juampis
MYSQL_USER=juampis
MYSQL_PASSWORD=juampis

# ---- Prisma ----
# Points at the container above. If you run the app inside Docker too, use host "mysql" instead of "localhost".
DATABASE_URL="mysql://juampis:juampis@localhost:3306/juampis"

# ---- WhatsApp Cloud API (Meta for Developers) ----
# Meta App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Long-lived System User token (NOT the 24h temporary one from the dashboard)
WHATSAPP_ACCESS_TOKEN=
# Any random string you choose; must match what you type in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-algo-aleatorio
# Graph API version
WHATSAPP_API_VERSION=v21.0
# Optional: verify the X-Hub-Signature-256 header (App Dashboard > Settings > Basic > App Secret)
META_APP_SECRET=

# ---- Staff / dispatch ----
# Comma-separated phone numbers in international format without "+", e.g. 573001112233,573004445566
STAFF_WA_IDS=

# ---- Admin API ----
# Required to call GET /orders (sent as header `x-api-key`). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=
